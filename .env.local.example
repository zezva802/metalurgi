# Optional — only needed for the live LLM agent (A4), AI mandate drafting (A5) and the
# streaming agent log (A7). Everything else runs without a key.
# Copy to .env.local (gitignored) and fill in your key:
#   cp .env.local.example .env.local
ANTHROPIC_API_KEY=

# Optional: override the model used by the live agent (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
