# Optional — only needed for the live LLM features: the live agent (A4), AI mandate drafting (A5),
# the streaming agent log (A7), and the AI "meaning" calls in the Supervisor review.
# Everything else (scripted agent, gateway, scores, supervisor hard facts) runs without a key.
# Copy to .env.local (gitignored) and fill in your key:
#   cp .env.local.example .env.local
#
# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-2.5-flash). Current Google docs show newer
# ids (e.g. gemini-3.8-flash) — set whatever your key has access to.
# GEMINI_MODEL=gemini-2.5-flash
